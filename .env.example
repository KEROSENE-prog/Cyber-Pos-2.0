# =============================================================================
# CYBERPOS 2.0 - LANEROS GAMER
# Archivo de Configuración de Entorno (Plantilla Ejemplo)
# =============================================================================
# Copie este archivo como .env en la raíz del proyecto para definir variables locales:
#   copy .env.example .env      (Windows CMD / PowerShell)
#   cp .env.example .env        (Linux / macOS)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO Y APLICACIÓN GENERAL
# -----------------------------------------------------------------------------
APP_NAME="CyberPOS - Laneros Gamer"
APP_ENV=local                        # local | testing | production
APP_DEBUG=true                       # true para desarrollo, false en producción
APP_URL=http://127.0.0.1:8000
APP_PORT=8000
APP_TIMEZONE=America/Caracas         # Zona horaria oficial del cyber (Venezuela)

# -----------------------------------------------------------------------------
# 2. CONEXIÓN A BASE DE DATOS (MySQL / MariaDB - XAMPP)
# -----------------------------------------------------------------------------
# Valores leídos por app/config.php mediante getenv():
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cyberpos
DB_USER=root
DB_PASS=                             # Contraseña vacía por defecto en XAMPP local
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# 3. SEGURIDAD Y SESIÓN (Tokens de Autenticación)
# -----------------------------------------------------------------------------
# Tiempo de vida del token de acceso (en segundos: 604800s = 7 días)
TOKEN_TTL=604800
# Clave secreta para firma o hashing de tokens adicionales / CSRF (generar aleatoria)
APP_SECRET_KEY=cyberpos_laneros_secret_token_change_in_production_2026

# -----------------------------------------------------------------------------
# 4. INTEGRACIÓN TASA CAMBIARIA BCV (Banco Central de Venezuela)
# -----------------------------------------------------------------------------
# API pública utilizada por el frontend (js/configuracion.js) para sincronizar tasa
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Frecuencia recomendada de refresco automático de la tasa (en horas)
BCV_REFRESH_INTERVAL_HOURS=3
# Tasa de contingencia en Bs por USD si la API no responde
BCV_FALLBACK_RATE=54.20

# -----------------------------------------------------------------------------
# 5. PARÁMETROS OPERATIVOS POR DEFECTO DEL CYBER
# -----------------------------------------------------------------------------
DEFAULT_HOURLY_RATE_PC=1.50          # Tarifa base en USD por hora en estación PC
DEFAULT_HOURLY_RATE_CONSOLE=2.50     # Tarifa base en USD por hora en Consola PS5
IVA_PERCENTAGE=0.16                  # Alícuota de impuesto aplicada en POS (16%)
THEME_PRIMARY_COLOR="#35c029"        # Verde corporativo Laneros Gamer

