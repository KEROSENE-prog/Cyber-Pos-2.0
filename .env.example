# Variables de entorno - CyberPOS (Laneros Gamer)
# Copiar este archivo como .env en la raiz del proyecto:
# copy .env.example .env

# Configuracion general del sistema
APP_NAME="CyberPOS - Laneros Gamer"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_PORT=8000
APP_TIMEZONE=America/Caracas

# Base de datos (MySQL / MariaDB en XAMPP)
# Estos valores los lee app/config.php con getenv()
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cyberpos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sesion y tokens
# Tiempo que dura el token de inicio de sesion (7 dias en segundos)
TOKEN_TTL=604800
APP_SECRET_KEY=clave_secreta_laneros_cyberpos_2026

# Tasa del dolar BCV
# API que consulta el frontend en configuracion.js para traer la tasa del dia
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_REFRESH_INTERVAL_HOURS=3
# Tasa de respaldo por si no hay internet o falla la API
BCV_FALLBACK_RATE=54.20

# Precios por defecto del cyber
DEFAULT_HOURLY_RATE_PC=1.50
DEFAULT_HOURLY_RATE_CONSOLE=2.50
IVA_PERCENTAGE=0.16
THEME_PRIMARY_COLOR="#35c029"
